# ShopEase Copilot - environment template.
# Copy to .env (PowerShell: Copy-Item .env.example .env) and fill in real values. .env is gitignored; never commit secrets.
# Every variable added to .env must be listed here (with a safe default or placeholder) and documented in docs/CONFIG.md.

# Postgres + Redis (docker-compose.yml)
POSTGRES_USER=shopease
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopease
POSTGRES_PORT=5432
REDIS_PORT=6379

# Host/timeout used by scripts/check_infra.py and (later) the app
POSTGRES_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
INFRA_CHECK_TIMEOUT_SECONDS=5

# Ollama (scripts/check_ollama.py; OLLAMA_BASE_URL is reused by the gateway later)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_CHECK_TIMEOUT_SECONDS=120
OLLAMA_CHECK_MAX_TOKENS=256
OLLAMA_CHECK_PROMPT=Reply with one short sentence: what is ShopEase?

# Gateway (gateway/config.yaml)
OLLAMA_API_BASE=http://host.docker.internal:11434
GROQ_API_KEY=your-groq-api-key-here

# LiteLLM Proxy container (docker-compose.yml)
LITELLM_PORT=4000

# Gateway check (scripts/check_gateway.py; keep in step with LITELLM_PORT)
GATEWAY_BASE_URL=http://127.0.0.1:4000/v1
GATEWAY_API_KEY=sk-not-required-yet
# The evals/loadtest teams' own virtual keys from scripts/create_keys.py.
# No script reads these yet (evals runner / Locust load tests are later
# steps) — kept here now so they're not lost before those exist.
EVALS_GATEWAY_KEY=sk-not-required-yet
LOADTEST_GATEWAY_KEY=sk-not-required-yet

# Copilot chat API (copilot/api.py). COPILOT_GATEWAY_KEY is the copilot team's
# virtual key from scripts/create_keys.py; the API calls the gateway with it.
COPILOT_GATEWAY_KEY=sk-not-required-yet
COPILOT_API_HOST=127.0.0.1
COPILOT_API_PORT=8001

# Prometheus (docker-compose profile "obs"; scrape config in observability/prometheus.yml)
PROMETHEUS_PORT=9090

# LiteLLM's own database (keep POSTGRES_USER/POSTGRES_PASSWORD in step with this)
LITELLM_DATABASE_URL=postgresql://shopease:change-me@postgres:5432/litellm

# LiteLLM admin/master key (scripts/create_keys.py)
LITELLM_MASTER_KEY=sk-local-master-change-me

# Spend log viewer (scripts/show_spend.py; keep LITELLM_DB_NAME in step with
# the db name in LITELLM_DATABASE_URL above)
LITELLM_DB_NAME=litellm
SPEND_LOG_DEFAULT_LIMIT=20
